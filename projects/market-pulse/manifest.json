{
  "manifest_version": 3,
  "name": "Market Pulse",
  "version": "1.0.0",
  "description": "Live gold, Toman, and crypto prices in a fast toolbar popup.",
  "action": {
    "default_title": "Market Pulse",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.gold-api.com/*",
    "https://api.brsapi.ir/*",
    "https://api.coingecko.com/*"
  ]
}
